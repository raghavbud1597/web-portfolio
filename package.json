{
  "name": "web-portfolio",
  "private": true,
  "homepage": "https://raghavbud1597.github.io/web-portfolio",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --port 8080",
    "format": "prettier --write src index.html vite.config.js eslint.config.js package.json README.md",
    "format:check": "prettier --check src index.html vite.config.js eslint.config.js package.json README.md"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
